/* ═══════════════════════════════════════════════════════════
   SistemaGestionVntsJG - Estilo "Neon Glass" v1.1
   Inspirado en glassmorphism con toques neón.
   ═══════════════════════════════════════════════════════════ */

/* ─────────────────────────────────────────────────────────── */
/* BASE Y VARIABLES (Implícitas en colores)                    */
/* ─────────────────────────────────────────────────────────── */

QWidget {
    font-family: 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
    color: #E0E7FF; /* Un blanco azulado suave */
    font-size: 14px;
}

QMainWindow {
    background-color: #0F172A; /* Azul noche sólido (base) */
}

/* Estilo base para Diálogos (Login, Forms, Setup) */
QDialog {
     background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #1E293B, /* Azul grisáceo oscuro */
        stop:1 #0F172A  /* Azul noche */
    );
    border: 1px solid rgba(100, 116, 139, 0.4); /* Borde sutil */
    border-radius: 12px;
}

/* ─────────────────────────────────────────────────────────── */
/* SIDEBAR DE NAVEGACIÓN (#navBar en main_window.py)          */
/* ─────────────────────────────────────────────────────────── */

QListWidget#navBar {
    background: rgba(15, 23, 42, 0.7); /* Fondo más oscuro y translúcido */
    /* backdrop-filter: blur(15px); */ /* No soportado nativamente */
    border: none;
    border-right: 1px solid rgba(51, 65, 85, 0.5); /* Borde derecho más marcado */
    padding: 15px 0; /* Más padding vertical */
}

QListWidget::item {
    color: #94A3B8; /* Gris azulado para texto inactivo */
    padding: 15px 20px; /* Ajuste padding */
    margin: 5px 10px; /* Margen item */
    border-radius: 10px; /* Bordes redondeados */
    border-left: 4px solid transparent; /* Indicador izquierdo */
    font-size: 15px;
    font-weight: 500;
    text-align: left; /* Alineado a la izquierda */
    outline: 0px; /* Quitar borde de foco */
}

QListWidget::item:hover {
    background: rgba(99, 102, 241, 0.1); /* Fondo violeta muy suave */
    color: #C7D2FE; /* Texto violeta claro */
    border-left: 4px solid #6366F1; /* Indicador violeta */
}

QListWidget::item:selected {
    background: qlineargradient( /* Gradiente sutil al seleccionar */
        x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(99, 102, 241, 0.25),
        stop:1 rgba(139, 92, 246, 0.15)
    );
    color: #FFFFFF; /* Texto blanco */
    font-weight: 600; /* Más grueso */
    border-left: 4px solid #8B5CF6; /* Indicador violeta más brillante */
}

/* ─────────────────────────────────────────────────────────── */
/* ÁREA DE CONTENIDO PRINCIPAL                               */
/* ─────────────────────────────────────────────────────────── */

/* Estilo para las páginas dentro del QStackedWidget */
QStackedWidget > QWidget {
    background: transparent; /* Hereda fondo de QMainWindow */
    padding: 30px; /* Mayor padding */
}

/* Títulos de página (Dashboard, Inventario, etc.) */
QLabel#pageTitle {
    font-size: 28px; /* Un poco más pequeño */
    font-weight: 700;
    color: #F8FAFC; /* Casi blanco */
    padding-bottom: 15px; /* Solo padding inferior */
    margin-bottom: 25px; /* Más margen inferior */
    letter-spacing: -0.5px;
    border-bottom: 1px solid rgba(51, 65, 85, 0.7); /* Línea separadora */
}

/* Estilo general para subtítulos o labels descriptivos */
QLabel {
    color: #CBD5E1; /* Gris claro por defecto */
    background: transparent; /* Asegura fondo transparente */
}

/* ─────────────────────────────────────────────────────────── */
/* TARJETAS DE MÉTRICAS (Dashboard, Gastos, POS)              */
/* ─────────────────────────────────────────────────────────── */

QWidget#metricCard, QWidget#cartWidget { /* Aplica a ambos */
    background: qlineargradient( /* Gradiente vertical sutil */
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(51, 65, 85, 0.7), /* Gris azulado semi-transparente */
        stop:1 rgba(30, 41, 59, 0.8)  /* Azul oscuro semi-transparente */
    );
    border: 1px solid rgba(100, 116, 139, 0.4); /* Borde más visible */
    border-radius: 12px; /* Redondeo consistente */
    padding: 20px;
}
/* Asegura transparencia en hijos si es necesario */
QWidget#metricCard QWidget, QWidget#cartWidget QWidget { background: transparent; }
QWidget#metricCard QLabel, QWidget#cartWidget QLabel { background: transparent; }

/* Títulos dentro de las tarjetas */
QLabel#metricTitle {
    font-size: 12px; /* Más pequeño */
    font-weight: 600;
    color: #94A3B8; /* Gris azulado */
    text-transform: uppercase;
    letter-spacing: 0.8px;
    padding-bottom: 8px;
}

/* Valores grandes en las tarjetas */
QLabel#metricValue {
    font-size: 32px; /* Un poco más pequeño */
    font-weight: 700;
    letter-spacing: -1px;
    margin-top: 5px;
    color: #F8FAFC; /* Color base, se sobrescribe en Python para colores */
}

/* Estilo específico para el Total del Carrito */
QLabel#totalLabel { /* "TOTAL:" */
    font-size: 16px;
    font-weight: 600;
    color: #CBD5E1; /* Gris claro */
    text-transform: uppercase;
}
QLabel#totalValue { /* "$XXX.XX" */
    font-size: 28px;
    font-weight: 700;
    color: #34D399; /* Verde menta brillante */
}

/* ─────────────────────────────────────────────────────────── */
/* CAMPOS DE ENTRADA (QLineEdit, SpinBox, DateEdit)           */
/* ─────────────────────────────────────────────────────────── */

QLineEdit, QDoubleSpinBox, QSpinBox, QDateEdit {
    background: rgba(30, 41, 59, 0.6); /* Fondo más oscuro */
    border: 1px solid rgba(100, 116, 139, 0.5); /* Borde más visible */
    border-radius: 8px; /* Menos redondeo */
    padding: 12px 15px; /* Ajuste padding */
    font-size: 14px;
    color: #E0E7FF; /* Texto blanco azulado */
    selection-background-color: #6366F1; /* Selección violeta */
}

QLineEdit:focus, QDoubleSpinBox:focus, QSpinBox:focus, QDateEdit:focus {
    background: rgba(51, 65, 85, 0.6); /* Fondo grisáceo al enfocar */
    border: 1px solid #8B5CF6; /* Borde violeta brillante */
    outline: none;
}

QLineEdit:hover, QDoubleSpinBox:hover, QSpinBox:hover, QDateEdit:hover {
    border: 1px solid rgba(99, 102, 241, 0.7); /* Borde hover más sutil */
}

/* Placeholder text color */
QLineEdit[placeholderText] { color: #64748B; } /* Gris oscuro para placeholder */


/* ─────────────────────────────────────────────────────────── */
/* COMBOBOX                                                   */
/* ─────────────────────────────────────────────────────────── */

QComboBox {
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(100, 116, 139, 0.5);
    border-radius: 8px;
    padding: 12px 15px;
    font-size: 14px;
    color: #E0E7FF;
    min-width: 100px; /* Ajuste ancho mínimo */
}

QComboBox:hover {
    border: 1px solid rgba(99, 102, 241, 0.7);
}

QComboBox:focus {
    border: 1px solid #8B5CF6;
}

QComboBox::drop-down {
    border: none;
    background: transparent;
    width: 25px; /* Más angosto */
}

QComboBox::down-arrow {
    image: none;
    /* Triángulo más pequeño */
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #94A3B8;
    margin-right: 10px; /* Más centrado */
}

QComboBox QAbstractItemView { /* Estilo del desplegable */
    background: #1E293B; /* Fondo oscuro */
    border: 1px solid rgba(100, 116, 139, 0.5); /* Borde */
    border-radius: 8px;
    selection-background-color: #6366F1; /* Selección violeta */
    selection-color: white;
    color: #E0E7FF; /* Texto items */
    padding: 5px;
    outline: 0px;
}

/* ─────────────────────────────────────────────────────────── */
/* BOTONES                                                    */
/* ─────────────────────────────────────────────────────────── */

QPushButton {
    background: qlineargradient( /* Gradiente violeta base */
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #6366F1, stop:1 #4F46E5
    );
    color: white;
    font-size: 14px;
    font-weight: 600;
    padding: 10px 20px; /* Padding base */
    border-radius: 8px; /* Redondeo */
    border: none;
    min-height: 20px;
    outline: 0px;
}

QPushButton:hover {
    background: qlineargradient( /* Hover más brillante */
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #7C3AED, stop:1 #6366F1
    );
}

QPushButton:pressed {
    background: #4338CA; /* Presionado más oscuro */
    /* Efecto hundido */
    padding: 11px 20px 9px 20px;
}

QPushButton:disabled {
    background: rgba(71, 85, 105, 0.5); /* Gris deshabilitado */
    color: #64748B;
}

/* Botones específicos con IDs */

QPushButton#addButton, QPushButton#finalizeButton { /* Verde */
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #10B981, stop:1 #059669);
}
QPushButton#addButton:hover, QPushButton#finalizeButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #34D399, stop:1 #10B981);
}
QPushButton#finalizeButton { /* Más grande */
    padding: 12px 24px;
    font-size: 15px;
    font-weight: 700;
}

QPushButton#editButton { /* Naranja */
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #F59E0B, stop:1 #D97706);
    font-size: 13px; padding: 6px 12px; border-radius: 6px; /* Más pequeño */
}
QPushButton#editButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FBBF24, stop:1 #F59E0B);
}

QPushButton#deleteButton { /* Rojo */
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #EF4444, stop:1 #DC2626);
    font-size: 13px; padding: 6px 12px; border-radius: 6px;
}
QPushButton#deleteButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #F87171, stop:1 #EF4444);
}

QPushButton#cancelButton { /* Gris */
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #64748B, stop:1 #475569);
    padding: 12px 24px; /* Padding normal */
    color: #E2E8F0;
}
QPushButton#cancelButton:hover { /* Rojo hover */
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #F87171, stop:1 #EF4444);
    color: white;
}

/* Botón de prueba conexión (similar a editar) */
QPushButton#testButton { /* Naranja */
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #F59E0B, stop:1 #D97706);
}
QPushButton#testButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FBBF24, stop:1 #F59E0B);
}


/* ─────────────────────────────────────────────────────────── */
/* TABLAS (QTableWidget)                                      */
/* ─────────────────────────────────────────────────────────── */

QTableWidget {
    background: rgba(30, 41, 59, 0.7); /* Fondo tabla */
    border: 1px solid rgba(100, 116, 139, 0.3); /* Borde */
    border-radius: 12px; /* Redondeo */
    font-size: 14px;
    gridline-color: rgba(71, 85, 105, 0.4); /* Líneas internas más visibles */
    selection-background-color: rgba(99, 102, 241, 0.35); /* Selección */
    alternate-background-color: rgba(51, 65, 85, 0.15); /* Filas alternas más sutiles */
    outline: 0px;
}

QHeaderView::section { /* Cabecera de la tabla */
    background: rgba(51, 65, 85, 0.8); /* Fondo cabecera */
    color: #CBD5E1; /* Texto cabecera */
    padding: 12px 10px; /* Ajuste padding */
    border: none;
    border-bottom: 2px solid #6366F1; /* Línea inferior violeta */
    /* border-right: 1px solid rgba(71, 85, 105, 0.3); */ /* Quitamos borde derecho interno */
    font-weight: 600; /* Menos grueso */
    text-transform: none; /* Sin mayúsculas */
    font-size: 13px; /* Un poco más grande */
}
/* Redondeo solo en las esquinas superiores externas */
QHeaderView::section:first { border-top-left-radius: 12px; }
QHeaderView::section:last { border-top-right-radius: 12px; border-right: none; }

QTableWidget::item { /* Celdas */
    padding: 12px 10px; /* Padding celdas */
    border-bottom: 1px solid rgba(71, 85, 105, 0.3); /* Línea inferior celda */
    color: #E0E7FF; /* Texto celdas */
    border-right: 1px solid rgba(71, 85, 105, 0.3); /* Línea vertical celda */
}
QTableWidget::item:last { border-right: none; } /* Sin borde en la última celda */

QTableWidget::item:selected { /* Celda seleccionada */
    background: rgba(99, 102, 241, 0.35); /* Mismo que selection-background */
    color: #FFFFFF;
}

/* Widget dentro de la celda (para botones) debe ser transparente */
QTableWidget QWidget {
    background-color: transparent;
}


/* ─────────────────────────────────────────────────────────── */
/* VENTANA DE LOGIN                                           */
/* ─────────────────────────────────────────────────────────── */

/* Contenedor principal del login */
QWidget#container {
    background: qlineargradient( /* Gradiente más oscuro */
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(40, 53, 75, 0.9),
        stop:1 rgba(15, 23, 42, 0.9)
    );
    border: 1px solid rgba(100, 116, 139, 0.4); /* Borde */
    border-radius: 16px; /* Redondeo */
}
/* Labels dentro del contenedor */
QWidget#container QLabel { color: #E0E7FF; background: transparent; }
/* Título específico del login */
QWidget#container QLabel#title {
    color: #FFFFFF;
    font-size: 24px; /* Ajuste tamaño */
    font-weight: 700;
    letter-spacing: 1px; /* Menos espaciado */
}

/* ─────────────────────────────────────────────────────────── */
/* SCROLLBAR                                                  */
/* ─────────────────────────────────────────────────────────── */

QScrollArea { border: none; background: transparent; }

QScrollBar:vertical {
    background: rgba(15, 23, 42, 0.5); /* Fondo scrollbar */
    width: 10px; /* Más angosta */
    border-radius: 5px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: rgba(100, 116, 139, 0.6); /* Handle */
    border-radius: 5px;
    min-height: 25px;
}
QScrollBar::handle:vertical:hover { background: rgba(99, 102, 241, 0.7); } /* Handle hover */
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; border: none; background: none; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }

QScrollBar:horizontal { /* Similar a vertical */
    background: rgba(15, 23, 42, 0.5);
    height: 10px;
    border-radius: 5px;
}
QScrollBar::handle:horizontal { background: rgba(100, 116, 139, 0.6); border-radius: 5px; min-width: 25px; }
QScrollBar::handle:horizontal:hover { background: rgba(99, 102, 241, 0.7); }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0px; border: none; background: none; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }

/* ─────────────────────────────────────────────────────────── */
/* SPINBOX (Ajuste fino para QSS)                             */
/* ─────────────────────────────────────────────────────────── */
QSpinBox, QDoubleSpinBox { padding-right: 25px; } /* Espacio para flechas custom */

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right; /* Posición */
    width: 25px; /* Ancho botón */
    height: 50%; /* Mitad de altura */
    border: none;
    background: rgba(99, 102, 241, 0.1);
    border-top-right-radius: 8px; /* Redondeo esquina */
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 25px; height: 50%;
    border: none;
    background: rgba(99, 102, 241, 0.1);
    border-bottom-right-radius: 8px;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background: rgba(99, 102, 241, 0.25); /* Hover más notorio */
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { /* Flecha arriba */
    image: none; border-left: 4px solid transparent; border-right: 4px solid transparent; border-bottom: 5px solid #CBD5E1; width: 0; height: 0;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { /* Flecha abajo */
    image: none; border-left: 4px solid transparent; border-right: 4px solid transparent; border-top: 5px solid #CBD5E1; width: 0; height: 0;
}

/* ─────────────────────────────────────────────────────────── */
/* TOOLTIPS Y MESSAGEBOX                                      */
/* ─────────────────────────────────────────────────────────── */

QToolTip {
    background: rgba(15, 23, 42, 0.95); /* Fondo tooltip */
    color: #E0E7FF; /* Texto tooltip */
    border: 1px solid #6366F1; /* Borde violeta */
    border-radius: 6px; /* Redondeo */
    padding: 6px 10px; /* Padding */
    font-size: 13px;
    opacity: 240; /* Casi opaco */
}

QMessageBox {
    background: #1E293B; /* Fondo oscuro */
}
QMessageBox QLabel { /* Texto dentro del messagebox */
    color: #E0E7FF;
    font-size: 14px;
    background: transparent; /* Asegura fondo transparente */
}
QMessageBox QPushButton { /* Botones (OK, Cancelar) */
    min-width: 80px;
    padding: 8px 18px; /* Padding ajustado */
    margin: 5px;
}

/* ═══════════════════════════════════════════════════════════
   END OF STYLESHEET
   ═══════════════════════════════════════════════════════════ */
/* Hoja de Estilos QSS para InfinityTech - TEMA: DARK MODE */
QWidget {
    font-family: 'Segoe UI', sans-serif;
    color: #ECF0F1;
    font-size: 14px;
}
QMainWindow {
    background-color: #2C3E50;
}
QListWidget {
    background-color: #34495E;
    border: none;
}
QListWidget::item {
    color: #ECF0F1;
    padding: 18px 20px;
    border-right: 3px solid transparent;
}
QListWidget::item:hover {
    background-color: #3d566e;
    color: #FFFFFF;
}
QListWidget::item:selected {
    background-color: #3498db;
    color: white;
    font-weight: bold;
    border-right: 3px solid #FFFFFF;
}
QStackedWidget > QWidget {
    background-color: #2C3E50;
}
QLabel#pageTitle {
    font-size: 28px;
    font-weight: bold;
    color: #FFFFFF;
    padding: 10px;
}
QLineEdit, QDoubleSpinBox, QSpinBox, QComboBox, QDateEdit {
    background-color: #2C3E50;
    border: 1px solid #34495E;
    border-radius: 5px;
    padding: 10px;
    font-size: 14px;
    color: #ECF0F1;
}
QLineEdit:focus, QDoubleSpinBox:focus, QSpinBox:focus, QComboBox:focus, QDateEdit:focus {
    border: 1px solid #3498db;
}
QComboBox::drop-down {
    border: none;
}
QComboBox::down-arrow {
    image: url(app/icons/chevron-down.svg); /* Necesitarás este ícono */
}
QPushButton {
    background-color: #3498db;
    color: white;
    font-size: 14px;
    font-weight: bold;
    padding: 10px 20px;
    border-radius: 5px;
    border: none;
}
QPushButton:hover {
    background-color: #2980b9;
}
QPushButton#addButton {
    background-color: #27AE60;
    color: white;
}
QPushButton#addButton:hover {
    background-color: #229954;
}
QTableWidget {
    background-color: #34495E;
    border: 1px solid #2C3E50;
    font-size: 13px;
    border-radius: 5px;
    gridline-color: #2C3E50;
}
QHeaderView::section {
    background-color: #2C3E50;
    color: #ECF0F1;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #3498db;
    font-weight: bold;
    text-transform: uppercase;
}
QTableWidget::item {
    padding: 8px;
    border-bottom: 1px solid #2C3E50;
    color: #ECF0F1;
}
QTableWidget::item:selected {
    background-color: #3498db;
    color: white;
}
QTableWidget::item:hover {
    background-color: #3d566e;
}
QWidget#container {
    background-color: #34495E;
    border-radius: 10px;
    border: 1px solid #2C3E50;
}
QWidget#container QLabel {
    color: #ECF0F1;
}
QWidget#container QLabel#title {
    color: #FFFFFF;
}
QWidget#metricCard {
    background-color: #34495E;
    border: 1px solid #2C3E50;
    border-radius: 10px;
    padding: 20px;
}
QLabel#metricTitle {
    font-size: 14px;
    font-weight: bold;
    color: #bdc3c7;
}
QLabel#metricValue {
    font-size: 28px;
    font-weight: bold;
}
QPushButton#editButton {
    background-color: #F39C12;
    color: white;
    font-size: 12px;
    padding: 5px;
    border-radius: 3px;
}
QPushButton#editButton:hover {
    background-color: #E67E22;
}
QPushButton#deleteButton {
    background-color: #E74C3C;
    color: white;
    font-size: 12px;
    padding: 5px;
    border-radius: 3px;
}
QPushButton#deleteButton:hover {
    background-color: #C0392B;
}
/* Estilos para POS */
QWidget#cartWidget {
    background-color: #34495E;
    border-radius: 10px;
}
QLabel#totalLabel {
    font-size: 20px;
    font-weight: bold;
    color: white;
}
QLabel#totalValue {
    font-size: 24px;
    font-weight: bold;
    color: #27AE60; /* Verde */
}
QPushButton#finalizeButton {
    background-color: #27AE60;
    padding: 15px;
    font-size: 18px;
}
QPushButton#finalizeButton:hover {
    background-color: #229954;
}
QPushButton#cancelButton {
    background-color: #E74C3C;
}
QPushButton#cancelButton:hover {
    background-color: #C0392B;
}